{
  "name": "@local/dsh-dabaitu",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "大白兔外观包（一个插件管四件）：侧栏品牌图标 + 「大白兔白又白」文字，护眼暖黄纸质主题与纸纹叠加层，外壳顶栏的「截图」（可含界面或隐藏界面后拉框截图）与「豆包」入口。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./assets/mark-128.png": "./assets/mark-128.png",
    "./assets/paper-grain.png": "./assets/paper-grain.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/mark-128.png",
    "assets/paper-grain.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
